{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@/lib/api/locations": ["./lib/api/spatial/locations"],
      "@/lib/api/map": ["./lib/api/spatial/map"],
      "@/lib/api/investigations": ["./lib/api/investigation/investigations"],
      "@/lib/api/counterfactual": ["./lib/api/investigation/counterfactual"],
      "@/lib/api/evidence": ["./lib/api/investigation/evidence"],
      "@/lib/api/client": ["./lib/api/core/client"],
      "@/lib/types/map": ["./lib/types/spatial/map"],
      "@/lib/types/investigation": ["./lib/types/investigation/investigation"],
      "@/lib/types/evidence": ["./lib/types/analysis/evidence"],
      "@/lib/types/counterfactual": ["./lib/types/analysis/counterfactual"],
      "@/lib/types/enums": ["./lib/types/investigation/enums"],
      "@/lib/schemas/investigation": ["./lib/schemas/investigation/investigation"],
      "@/lib/schemas/counterfactual": ["./lib/schemas/analysis/counterfactual"],
      "@/lib/schemas/evidence": ["./lib/schemas/analysis/evidence"],
      "@/lib/formatting": ["./lib/format/formatting"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
