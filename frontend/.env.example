# ==============================================================================
# FloodLens Frontend Environment Configuration
# ==============================================================================

# API Base URL (FastAPI Backend / Lambda Proxy)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Supabase Authentication & Database Configuration
# ------------------------------------------------------------------------------
# 1. Project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Anonymous Key (safe for browser client-side usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# 3. Google OAuth Configuration in Supabase Dashboard:
#    - Authentication -> Providers -> Google (Enabled)
#    - Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
#    - Authorized redirect URI: https://your-project-ref.supabase.co/auth/v1/callback
#    - Application redirect: http://localhost:3000/auth/callback (dev) / https://floodlens-app.vercel.app/auth/callback (prod)

# 4. Indian Mobile Phone SMS OTP Configuration:
#    - Authentication -> Providers -> Phone (Enabled)
#    - SMS Provider: Twilio / MessageBird / AWS SNS
#    - Default Country: India (+91)
